# .streamlit/secrets.toml.example — Streamlit Community Cloud format
#
# To use: on your app's Streamlit Cloud page, click Settings → Secrets,
# and paste this content (with real values). Do NOT commit the actual
# .streamlit/secrets.toml — it's gitignored.

ADMIN_EMAIL = "your.email@company.com"
JWT_SECRET = "your-real-32+-char-random-secret"

# Data
SALES_XLSX = "data/Copy_of_Sales_Data-dummy.xlsx"
DB_PATH = "./invoices.db"
AUTH_DB_PATH = "./auth.db"

# Reminders
CC_EMAIL = ""
SENDER_NAME = "Accounts Team"
SENDER_COMPANY = "Infrabeat Technologies"
REMINDER_BEFORE_DUE_DAYS = "3"
NOTIFY_LEAD_DAYS = "5"
REMINDER_COOLDOWN_DAYS = "5"

# LLM — Groq is the ONLY option on the cloud (Ollama can't run there)
GROQ_API_KEY = "gsk_your_real_key_here"
GROQ_MODEL = "llama-3.3-70b-versatile"

# Scheduler
SCAN_DAILY_HOUR = "11"
SCAN_DAILY_MINUTE = "0"
SCAN_DAYS_BACK = "30"
SCAN_MIN_INTERVAL_MIN = "60"
