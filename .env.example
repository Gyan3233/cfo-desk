# .env.example — copy to .env and fill in real values
# The .env file is gitignored; NEVER commit real secrets.

# ── Auth ──────────────────────────────────────────────────────────────
ADMIN_EMAIL=your.email@company.com
JWT_SECRET=change-me-to-a-long-random-string-32-chars-minimum

# ── Data source ───────────────────────────────────────────────────────
SALES_XLSX=data/Copy_of_Sales_Data-dummy.xlsx
DB_PATH=./invoices.db
AUTH_DB_PATH=./auth.db

# ── Reminder email lifecycle ─────────────────────────────────────────
CC_EMAIL=
SENDER_NAME=Accounts Team
SENDER_COMPANY=Your Company
REMINDER_BEFORE_DUE_DAYS=3
NOTIFY_LEAD_DAYS=5
REMINDER_COOLDOWN_DAYS=5

# ── LLM providers ────────────────────────────────────────────────────
# Ollama for local dev (private, free, needs `ollama serve` running).
# Groq API as cloud fallback when Ollama isn't reachable — REQUIRED
# for the deployed version on Streamlit Community Cloud.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Gmail scan scheduler ─────────────────────────────────────────────
SCAN_DAILY_HOUR=11
SCAN_DAILY_MINUTE=0
SCAN_DAYS_BACK=30
SCAN_MIN_INTERVAL_MIN=60
